{
  "expo": {
    "name": "mr-pill-pal",
    "slug": "mr-pill-pal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mrpillpal",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mrpillpal",
      "googleServicesFile": "./google-services.json",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF4E9",
          "image": "./assets/brand/runtime/ui/Simplified standalone brand symbol/mpp-symbol-simple- 1024 x 1024.png",
          "imageWidth": 128,
          "dark": {
            "backgroundColor": "#14211E",
            "image": "./assets/brand/runtime/ui/Simplified standalone brand symbol/mpp-symbol-simple- 1024 x 1024.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "firebaseGoogleWebClientId": "877571125639-ki5jo1dmge6pl6krco6it2r6nvj0mfjj.apps.googleusercontent.com"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
